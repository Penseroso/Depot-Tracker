---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEvents } from '../lib/data';
import { formatDate } from '../lib/format';
import { getAdditionalSourceCount, getPrimarySource } from '../lib/event-order.js';
const events = getEvents();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Updates | Obesity Depot Tracker" activePath="/updates/">
  <header class="page-heading"><div><p class="eyebrow">Change log</p><h1>Update Feed</h1></div></header>
  <section class="section panel panel-pad feed">
    {events.map((event) => {
      const primarySource = getPrimarySource(event);
      const additionalSourceCount = getAdditionalSourceCount(event);
      return (
        <article class="feed-item">
          <time class="feed-date" datetime={event.date}>{formatDate(event.date)}</time>
          <div><h2 class="feed-title"><a class="row-link" href={`${base}/programs/${event.programSlug}/`}>{event.headline}</a></h2><div class="feed-meta">{event.company} | {event.programName} | {event.category} | 중요도 {event.significance}</div></div>
          {primarySource && (
            <a class="feed-source" href={primarySource.url} target="_blank" rel="noreferrer">원문 ↗{additionalSourceCount > 0 && ` 외 ${additionalSourceCount}개`}</a>
          )}
        </article>
      );
    })}
  </section>
</BaseLayout>
