---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEvents } from '../lib/data';
import { formatDate } from '../lib/format';
const events = getEvents();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="Updates · Semaglutide Depot Tracker" activePath="/updates/">
  <header class="page-heading"><div><p class="eyebrow">Change log</p><h1>Update Feed</h1></div></header>
  <section class="section panel panel-pad feed">
    {events.map((event) => (
      <article class="feed-item">
        <time class="feed-date" datetime={event.date}>{formatDate(event.date)}</time>
        <div><h2 class="feed-title"><a class="row-link" href={`${base}/programs/${event.programSlug}/`}>{event.headline}</a></h2><div class="feed-meta">{event.company} · {event.programName} · {event.category} · 중요도 {event.significance}</div></div>
        <a class="feed-source" href={event.source.url} target="_blank" rel="noreferrer">원문 ↗</a>
      </article>
    ))}
  </section>
</BaseLayout>
