---
import BaseLayout from '../layouts/BaseLayout.astro';
import LandscapeCharts from '../components/LandscapeCharts';
import StageBadge from '../components/StageBadge.astro';
import { getDeliveryTechnologies, getEvents, getLatestEventForProgram, getPrograms, getStudies, getSummary } from '../lib/data';
import { formatDate, formatIntervalClaim } from '../lib/format';
import { getAdditionalSourceCount, getPrimarySource } from '../lib/event-order.js';

const programs = getPrograms();
const studies = getStudies();
const events = getEvents();
const deliveryTechnologies = getDeliveryTechnologies();
const technologyById = new Map(deliveryTechnologies.map((item) => [item.id, item]));
const summary = getSummary(programs, events, studies);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const priority = programs.filter((program) => program.active).slice(0, 6);
---
<BaseLayout title="Obesity Depot Tracker" activePath="/">
  <section class="hero">
    <div>
      <p class="eyebrow">Competitive intelligence | 최근 검증일 {summary.asOfDate ? formatDate(summary.asOfDate) : '—'}</p>
      <h1>Obesity depot landscape</h1>
      <p class="hero-scope">비만 또는 과체중 치료 목적의 장기지속형 주사 및 삽입 후보를 추적합니다. 현재 저장 데이터는 기존 semaglutide 중심이며 전체 범위 조사는 아직 반영되지 않았습니다.</p>
    </div>
  </section>

  <section class="metric-strip" aria-label="핵심 지표">
    <div class="metric"><div class="metric-label">PROGRAMS</div><div class="metric-value">{summary.total}</div><div class="metric-note">{summary.total} programs | {summary.active} currently active</div></div>
    <div class="metric"><div class="metric-label">TRIAL REGISTRATIONS</div><div class="metric-value">{summary.trialRegistrations}</div><div class="metric-note">ClinicalTrials.gov, CTIS 등 전체 registry 등록 수</div></div>
    <div class="metric"><div class="metric-label">PATENT-LINKED PROGRAMS</div><div class="metric-value">{summary.patentLinkedPrograms}</div><div class="metric-note">{summary.patentLinkedPrograms} of {summary.total} programs | {summary.patentLinkedPercent}%</div></div>
  </section>

  <section class="section">
    <div class="section-head"><div><h2>Landscape</h2></div></div>
    <LandscapeCharts programs={programs} deliveryTechnologies={deliveryTechnologies} client:visible />
  </section>

  <section class="section">
    <div class="section-head">
      <div><h2>Priority watchlist</h2></div>
      <a class="text-link" href={`${base}/programs/`}>전체 프로그램 →</a>
    </div>
    <div class="panel data-table-wrap">
      <table class="data-table">
        <thead><tr><th>프로그램</th><th>제형군</th><th>목표 간격</th><th>개발 단계</th><th>최근 변화</th></tr></thead>
        <tbody>
          {priority.map((program) => {
            const latestEvent = getLatestEventForProgram(program.slug, events);
            return (
              <tr>
                <td><a class="row-link" href={`${base}/programs/${program.slug}/`}><span class="cell-title">{program.programName}</span><span class="cell-sub">{program.company}</span></a></td>
                <td><span class="cell-title">{technologyById.get(program.deliveryTechnologyId)?.shortLabel ?? program.deliveryTechnologyId}</span><span class="cell-sub">{program.deliveryTechnology}</span></td>
                <td>{formatIntervalClaim(program.productTarget)}</td>
                <td><StageBadge stage={program.developmentStage} /></td>
                <td>{latestEvent ? formatDate(latestEvent.date) : '—'}</td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div><h2>Latest changes</h2></div>
      <a class="text-link" href={`${base}/updates/`}>변경 이력 →</a>
    </div>
    <div class="panel panel-pad feed">
      {events.slice(0, 5).map((event) => {
        const primarySource = getPrimarySource(event);
        const additionalSourceCount = getAdditionalSourceCount(event);
        return (
          <article class="feed-item">
            <time class="feed-date" datetime={event.date}>{formatDate(event.date)}</time>
            <div><h3 class="feed-title"><a class="row-link" href={`${base}/programs/${event.programSlug}/`}>{event.headline}</a></h3><div class="feed-meta">{event.company} | {event.programName} | {event.category}</div></div>
            {primarySource && (
              <a class="feed-source" href={primarySource.url} target="_blank" rel="noreferrer">원문 ↗{additionalSourceCount > 0 && ` 외 ${additionalSourceCount}개`}</a>
            )}
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
