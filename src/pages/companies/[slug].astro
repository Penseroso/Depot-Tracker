---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StageBadge from '../../components/StageBadge.astro';
import {
  getCompanies,
  getPlatforms,
  getPlatformsForCompany,
  getPrograms,
  getProgramsForCompany,
  getPublicCompanies,
} from '../../lib/data';
import { formatDate } from '../../lib/format';

export function getStaticPaths() {
  const programs = getPrograms();
  const platforms = getPlatforms();
  return getPublicCompanies(getCompanies()).map((company) => ({
    params: { slug: company.slug },
    props: {
      company,
      programs: getProgramsForCompany(company, programs),
      platforms: getPlatformsForCompany(company.slug, platforms),
    },
  }));
}

const { company, programs, platforms } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const relationshipLabel = {
  ownership: 'Ownership',
  license: 'License',
  access: 'Access',
};
---
<BaseLayout title={`${company.name} | Obesity Depot Tracker`} activePath="/companies/">
  <a class="text-link" href={`${base}/companies/`}>← Company directory</a>
  <header class="detail-head company-head">
    <div>
      <p class="eyebrow">Company reference</p>
      <h1>{company.name}</h1>
      <p class="detail-company">Reference checked {formatDate(company.lastVerifiedAt)}</p>
    </div>
    <div class="actions">
      <a class="button" href={company.homepageUrl} target="_blank" rel="noreferrer">Official website ↗</a>
      <a class="button button-primary" href={company.pipelineUrl} target="_blank" rel="noreferrer">Official pipeline ↗</a>
    </div>
  </header>

  <section class="section">
    <div class="section-head">
      <div><h2>Stored Programs</h2><p>Program data의 company 값에서 자동 파생됩니다.</p></div>
    </div>
    <div class="company-program-list">
      {programs.map((program) => (
        <a class="company-program-row" href={`${base}/programs/${program.slug}/`}>
          <span><strong>{program.programName}</strong><small>{program.company}</small></span>
          <StageBadge stage={program.developmentStage} />
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <div><h2>Verified Platforms</h2><p>공식 플랫폼 identifier와 대표 patent family가 직접 확인된 항목만 표시합니다.</p></div>
    </div>
    <div class="platform-list">
      {platforms.map((platform) => {
        const relationships = platform.relationships.filter((item) => item.companySlug === company.slug);
        return (
          <article class="platform-card">
            <div class="platform-card-head">
              <div>
                <h3>{platform.name}</h3>
                {platform.aliases.length > 0 && <p>{platform.aliases.join(' / ')}</p>}
              </div>
              <a class="text-link" href={platform.officialUrl} target="_blank" rel="noreferrer">Official platform ↗</a>
            </div>
            {relationships.map((relationship) => (
              <div class="platform-relation">
                <span class="meta-pill">{relationshipLabel[relationship.relationship]}</span>
                <span><strong>Rights holder:</strong> {relationship.rightsHolderName}</span>
                {relationship.status === 'former' && <span class="meta-pill">Former</span>}
              </div>
            ))}
            <div class="patent-evidence-list">
              {platform.patentEvidence.map((patent) => (
                <a class="patent-evidence" href={patent.url} target="_blank" rel="noreferrer">
                  <span>
                    <strong>{patent.familyId}</strong>
                    <small>{patent.publicationNumber}{patent.grantNumber ? ` / ${patent.grantNumber}` : ''}</small>
                  </span>
                  <span>
                    <small>Earliest priority</small>
                    <strong>{formatDate(patent.earliestPriority)}</strong>
                  </span>
                </a>
              ))}
            </div>
          </article>
        );
      })}
    </div>
  </section>
</BaseLayout>
