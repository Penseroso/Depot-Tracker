---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProgramExplorer from '../../components/ProgramExplorer';
import { getDeliveryTechnologies, getPrograms, getStudies } from '../../lib/data';
const programs = getPrograms();
const studies = getStudies();
const deliveryTechnologies = getDeliveryTechnologies();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asOfDate = [
  ...programs.map((program) => program.lastVerifiedAt),
  ...studies.map((study) => study.lastVerifiedAt),
].sort().at(-1) ?? '1970-01-01';
---
<BaseLayout title="Programs | Semaglutide Depot Tracker" activePath="/programs/">
  <header class="page-heading">
    <div><p class="eyebrow">Program register</p><h1>Competitive Programs</h1></div>
    <div class="actions">
      <a class="button" href={`${base}/api/programs.csv`} download>CSV</a>
      <a class="button button-primary" href={`${base}/api/snapshot.json`} download>JSON snapshot</a>
    </div>
  </header>
  <ProgramExplorer programs={programs} studies={studies} deliveryTechnologies={deliveryTechnologies} basePath={base} asOfDate={asOfDate} client:load />
</BaseLayout>
