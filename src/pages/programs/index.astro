---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProgramExplorer from '../../components/ProgramExplorer';
import { getDeliveryTechnologies, getEvents, getLatestEventForProgram, getPrograms, getPublicCompanies, getStudies } from '../../lib/data';
const programs = getPrograms();
const studies = getStudies();
const events = getEvents();
const deliveryTechnologies = getDeliveryTechnologies();
const companyLinksByProgramCompany = getPublicCompanies().reduce<Record<string, { name: string; slug: string }[]>>(
  (links, company) => {
    for (const programCompanyName of company.programCompanyNames) {
      (links[programCompanyName] ??= []).push({ name: company.name, slug: company.slug });
    }
    return links;
  },
  {},
);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const asOfDate = [
  ...programs.map((program) => program.lastVerifiedAt),
  ...studies.map((study) => study.lastVerifiedAt),
].sort().at(-1) ?? '1970-01-01';
const latestEventDateByProgram = Object.fromEntries(
  programs.map((program) => [program.slug, getLatestEventForProgram(program.slug, events)?.date ?? null]),
);
---
<BaseLayout title="Programs | Obesity Depot Tracker" activePath="/programs/">
  <header class="page-heading">
    <div><p class="eyebrow">Program register</p><h1>Competitive Programs</h1></div>
    <div class="actions">
      <a class="button" href={`${base}/api/programs.csv`} download>CSV</a>
      <a class="button button-primary" href={`${base}/api/snapshot.json`} download>JSON snapshot</a>
    </div>
  </header>
  <ProgramExplorer programs={programs} deliveryTechnologies={deliveryTechnologies} companyLinksByProgramCompany={companyLinksByProgramCompany} basePath={base} asOfDate={asOfDate} latestEventDateByProgram={latestEventDateByProgram} client:load />
</BaseLayout>
