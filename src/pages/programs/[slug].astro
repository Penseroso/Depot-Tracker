---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StageBadge from '../../components/StageBadge.astro';
import ConfidenceBadge from '../../components/ConfidenceBadge.astro';
import { getDeliveryTechnologies, getPrograms, getStudies } from '../../lib/data';
import { formatDate, formatIntervalClaim, formatPayloadComponents } from '../../lib/format';

export function getStaticPaths() {
  const studies = getStudies();
  return getPrograms().map((program) => ({
    params: { slug: program.slug },
    props: { program, studies: studies.filter((study) => study.programSlug === program.slug) },
  }));
}

const { program, studies } = Astro.props;
const technology = getDeliveryTechnologies().find((item) => item.id === program.deliveryTechnologyId);
const patents = program.sources.filter((source) => source.sourceType === 'patent');
const supportingSources = program.sources.filter((source) => source.sourceType !== 'patent');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title={`${program.programName} | Obesity Depot Tracker`} activePath="/programs/">
  <a class="text-link" href={`${base}/programs/`}>← Program register</a>
  <header class="detail-head">
    <div class="detail-topline"><StageBadge stage={program.developmentStage} /><ConfidenceBadge confidence={program.confidence} /><span class="meta-pill">{technology?.label ?? program.deliveryTechnologyId}</span><span class="meta-pill">{program.recordType === 'sponsor-program' ? 'Sponsor program' : 'Technology watch'}</span></div>
    <h1>{program.programName}</h1>
    <p class="detail-company">{program.company}</p>
  </header>
  <div class="detail-layout">
    <div>
      <section class="detail-section"><h2>요약</h2><p>{program.readout}</p></section>
      <section class="detail-section"><h2>최근 변화</h2><p>{program.latestUpdate}</p></section>
      <section class="detail-section"><h2>제형 차별점</h2><p>{program.differentiator}</p></section>
      <section class="detail-section"><h2>유의사항</h2><div class="alert-box">{program.caveat}</div></section>
      {studies.length > 0 && (
        <section class="detail-section">
          <h2>연결 Study</h2>
          <div class="panel data-table-wrap">
            <table class="data-table">
              <thead><tr><th>Registry / ID</th><th>Phase</th><th>모집 상태</th><th>국가</th><th>마지막 검증</th></tr></thead>
              <tbody>
                {studies.map((study) => (
                  <tr>
                    <td><a class="text-link" href={study.registrySource.url} target="_blank" rel="noreferrer"><span class="cell-title">{study.registry}</span><span class="cell-sub">{study.registryId} ↗</span></a></td>
                    <td>{study.phase}</td>
                    <td><span class="cell-title">{study.registryStatusRaw}</span><span class="cell-sub">{study.recruitmentStatus}</span></td>
                    <td>{study.countries.length ? study.countries.join(', ') : '—'}</td>
                    <td><span class="cell-title">{formatDate(study.lastVerifiedAt)}</span><span class="cell-sub">source accessed {study.registrySource.accessedOn}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}
      {patents.length > 0 && (
        <section class="detail-section">
          <h2>연결 Patent</h2>
          <div class="panel panel-pad source-list">
            {patents.map((patent) => (
              <a class="source-link" href={patent.url} target="_blank" rel="noreferrer">
                <span class="source-label">{patent.label} ↗</span>
                <span class="source-meta">patent | accessed {patent.accessedOn}</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
    <aside class="sidebar-panel">
      <h2 class="panel-title">Program facts</h2>
      <dl class="fact-list">
        <div class="fact-row"><dt>Payload</dt><dd>{formatPayloadComponents(program.payloadComponents)}</dd></div>
        <div class="fact-row"><dt>제형</dt><dd>{program.deliveryTechnology}</dd></div>
        <div class="fact-row"><dt>제품 목표</dt><dd>{formatIntervalClaim(program.productTarget)}</dd></div>
        <div class="fact-row"><dt>입증 기간</dt><dd>{formatIntervalClaim(program.demonstratedDuration)}</dd></div>
        <div class="fact-row"><dt>플랫폼 잠재력</dt><dd>{formatIntervalClaim(program.platformPotential)}</dd></div>
        <div class="fact-row"><dt>투여경로</dt><dd>{program.route}</dd></div>
        <div class="fact-row"><dt>개발 상태</dt><dd>{program.developmentStatus}</dd></div>
        <div class="fact-row"><dt>최근 변화</dt><dd>{formatDate(program.latestUpdateDate)}</dd></div>
        <div class="fact-row"><dt>마지막 검증</dt><dd>{formatDate(program.lastVerifiedAt)}</dd></div>
      </dl>
      <h2 class="panel-title" style="margin-top:22px">Sources</h2>
      <div class="source-list">
        {supportingSources.map((source) => (
          <a class="source-link" href={source.url} target="_blank" rel="noreferrer">
            <span class="source-label">{source.label} ↗</span>
            <span class="source-meta">{source.sourceType} | accessed {source.accessedOn}</span>
          </a>
        ))}
      </div>
    </aside>
  </div>
</BaseLayout>
