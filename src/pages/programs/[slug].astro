---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StageBadge from '../../components/StageBadge.astro';
import ClauseText from '../../components/ClauseText.astro';
import EventEntry from '../../components/EventEntry.astro';
import TimelineEntry from '../../components/TimelineEntry.astro';
import { getCompanies, getCompaniesForProgram, getDeliveryTechnologies, getEvents, getEventsForProgram, getPrograms, getStudies } from '../../lib/data';
import { formatDate, formatIntervalClaim, formatPayloadComponents, stageLabel } from '../../lib/format';
import { getDurationMechanismLabel } from '../../lib/duration-mechanisms.js';

export function getStaticPaths() {
  const studies = getStudies();
  const events = getEvents();
  return getPrograms().map((program) => ({
    params: { slug: program.slug },
    props: {
      program,
      studies: studies.filter((study) => study.programSlug === program.slug),
      events: getEventsForProgram(program.slug, events),
    },
  }));
}

const { program, studies, events } = Astro.props;
const technology = getDeliveryTechnologies().find((item) => item.id === program.deliveryTechnologyId);
const companies = getCompaniesForProgram(program, getCompanies()).filter((company) => company.visibility === 'public');
const patents = program.sources.filter((source) => source.sourceType === 'patent');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const studyBySlug = new Map(studies.map((study) => [study.slug, study]));
const latestEvent = events[0] ?? null;
const earlierEvents = events.slice(1);
const timelineHead = earlierEvents.slice(0, 5);
const timelineRest = earlierEvents.slice(5);
---
<BaseLayout title={`${program.programName} | Obesity Depot Tracker`} activePath="/programs/">
  <a class="text-link" href={`${base}/programs/`}>← Program register</a>
  <header class="detail-head">
    <div class="detail-topline"><StageBadge stage={program.developmentStage} /><span class="meta-pill">{technology?.label ?? program.deliveryTechnologyId}</span><span class="meta-pill">{program.recordType === 'sponsor-program' ? 'Sponsor program' : 'Technology watch'}</span></div>
    <h1>{program.programName}</h1>
    <p class="detail-company">
      {companies.length > 0
        ? companies.map((company, index) => (
          <><a class="text-link" href={`${base}/companies/${company.slug}/`}>{company.name}</a>{index < companies.length - 1 ? ' / ' : ''}</>
        ))
        : program.company}
    </p>
  </header>
  <div class="detail-layout">
    <div>
      <section class="detail-section">
        <p class="eyebrow">Latest development</p>
        {latestEvent ? (
          <EventEntry event={latestEvent} study={latestEvent.studySlug ? studyBySlug.get(latestEvent.studySlug) : undefined} />
        ) : (
          <p class="event-empty">기록된 material change가 없습니다.</p>
        )}
      </section>

      <section class="detail-section">
        <h2>Evidence snapshot</h2>
        <div class="evidence-grid">
          <div class="detail-subsection"><h3>Evidence summary</h3><ClauseText text={program.readout} class="subsection-text" /></div>
          <div class="detail-subsection"><h3>Formulation rationale</h3><ClauseText text={program.differentiator} class="subsection-text" /></div>
          <div class="detail-subsection"><h3>Interpretation limits</h3><ClauseText text={program.caveat} class="subsection-text" /></div>
        </div>
      </section>

      {earlierEvents.length > 0 && (
        <section class="detail-section">
          <h2>Earlier developments</h2>
          <ol class="chrono">
            {timelineHead.map((event) => (
              <TimelineEntry event={event} study={event.studySlug ? studyBySlug.get(event.studySlug) : undefined} />
            ))}
          </ol>
          {timelineRest.length > 0 && (
            <details class="timeline-more">
              <summary>이전 이력 {timelineRest.length}건 더 보기</summary>
              <ol class="chrono">
                {timelineRest.map((event) => (
                  <TimelineEntry event={event} study={event.studySlug ? studyBySlug.get(event.studySlug) : undefined} />
                ))}
              </ol>
            </details>
          )}
        </section>
      )}

      {studies.length > 0 && (
        <section class="detail-section">
          <h2>연결 Study</h2>
          <div class="panel data-table-wrap">
            <table class="data-table">
              <thead><tr><th>Registry / ID</th><th>Phase</th><th>모집 상태</th><th>국가</th><th>마지막 검증</th></tr></thead>
              <tbody>
                {studies.map((study) => (
                  <tr id={`study-${study.slug}`}>
                    <td><a class="text-link" href={study.registrySource.url} target="_blank" rel="noreferrer"><span class="cell-title">{study.registry}</span><span class="cell-sub">{study.registryId} ↗</span></a></td>
                    <td>{study.phase}</td>
                    <td><span class="cell-title">{study.registryStatusRaw}</span><span class="cell-sub">{study.recruitmentStatus}</span></td>
                    <td>{study.countries.length ? study.countries.join(', ') : '—'}</td>
                    <td><span class="cell-title">{formatDate(study.lastVerifiedAt)}</span><span class="cell-sub">source accessed {study.registrySource.accessedOn}</span></td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )}
      {patents.length > 0 && (
        <section class="detail-section">
          <h2>Linked patents</h2>
          <div class="panel panel-pad source-list">
            {patents.map((patent) => (
              <a class="source-link" href={patent.url} target="_blank" rel="noreferrer">
                <span class="source-label">{patent.label} ↗</span>
                <span class="source-meta">patent | accessed {patent.accessedOn}</span>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>
    <aside class="sidebar-panel">
      <h2 class="panel-title">Current state</h2>
      <dl class="fact-list">
        <div class="fact-row"><dt>Payload</dt><dd>{formatPayloadComponents(program.payloadComponents)}</dd></div>
        <div class="fact-row"><dt>제형</dt><dd>{program.deliveryTechnology}</dd></div>
        <div class="fact-row"><dt>지속기전</dt><dd>{getDurationMechanismLabel(program.durationMechanismId)}</dd></div>
        <div class="fact-row"><dt>목표 투여 간격</dt><dd>{formatIntervalClaim(program.productTarget)}</dd></div>
        <div class="fact-row"><dt>투여경로</dt><dd>{program.route}</dd></div>
        <div class="fact-row"><dt>개발 단계</dt><dd>{stageLabel(program.developmentStage)}</dd></div>
        <div class="fact-row"><dt>개발 상태</dt><dd>{program.developmentStatus}</dd></div>
        <div class="fact-row"><dt>최근 변화</dt><dd>{latestEvent ? formatDate(latestEvent.date) : '기록된 material change 없음'}</dd></div>
        <div class="fact-row"><dt>최근 검증일</dt><dd>{formatDate(program.lastVerifiedAt)}</dd></div>
      </dl>
      <details class="sources-disclosure">
        <summary>All sources ({program.sources.length})</summary>
        <div class="source-list">
          {program.sources.map((source) => (
            <a class="source-link" href={source.url} target="_blank" rel="noreferrer">
              <span class="source-label">{source.label} ↗</span>
              <span class="source-meta">{source.sourceType} | accessed {source.accessedOn}</span>
            </a>
          ))}
        </div>
      </details>
    </aside>
  </div>
</BaseLayout>
