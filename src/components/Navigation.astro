---
interface Props { activePath: string }
const { activePath } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const items = [
  { href: `${base}/`, label: 'Overview', path: '/' },
  { href: `${base}/programs/`, label: 'Programs', path: '/programs/' },
  { href: `${base}/updates/`, label: 'Updates', path: '/updates/' },
];
---
<header class="topbar">
  <div class="page-wrap topbar-inner">
    <a class="brand" href={`${base}/`}>
      <span class="brand-mark" aria-hidden="true">O</span>
      <span>Obesity Depot Tracker</span>
    </a>
    <nav class="nav" aria-label="주요 메뉴">
      {items.map((item) => (
        <a href={item.href} aria-current={activePath === item.path ? 'page' : undefined}>{item.label}</a>
      ))}
    </nav>
  </div>
</header>
